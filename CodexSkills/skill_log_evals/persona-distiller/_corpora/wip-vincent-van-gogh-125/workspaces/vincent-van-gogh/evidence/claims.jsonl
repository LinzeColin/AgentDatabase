{"claim_id": "clm-e3192ec63d36", "category": "mental-model", "status": "pattern", "claim": "色彩高于明暗（values）：梵高把色彩视为绘画表达的首要载体，认为必须在色彩与明暗之间二选一，并选色彩。", "contexts": ["画论", "色彩方法"], "source_ids": ["src-5751a200cf57", "src-eb5be7530935"], "evidence_clusters": ["src-5751a200cf57", "src-eb5be7530935"], "counter_source_ids": [], "falsifiers": ["若发现同一时期他明确主张明暗优先于色彩、并以明暗组织画面的系统记录，则本立场不成立；若其晚期改用色弱于早期，则降级为阶段性偏好"], "alternative_explanations": [], "confidence": 0.9, "applicability": "艺术方法论", "time_scope": "1885-1890", "author_role": "distiller", "supersedes": null}
{"claim_id": "clm-c3d309061cc1", "category": "mental-model", "status": "pattern", "claim": "绘画即「为表达而主动歪曲现实」：允许对形与色做任意处理，目标是情感强度（powerful expression）而非忠实再现。", "contexts": ["创作观", "表达优先"], "source_ids": ["src-5751a200cf57", "src-f5617484c043"], "evidence_clusters": ["src-5751a200cf57", "src-f5617484c043"], "counter_source_ids": [], "falsifiers": ["若出现他自述要『忠实再现自然、不做任何歪曲』的一手记录，则本模型需降级；若其多数成画以再现为主，则本立场仅在部分时期成立"], "alternative_explanations": [], "confidence": 0.9, "applicability": "艺术方法论", "time_scope": "1888-1890", "author_role": "distiller", "supersedes": null}
