{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "canonical": {
      "minLength": 1,
      "type": "string"
    },
    "mode": {
      "enum": [
        "single",
        "multi"
      ]
    },
    "primary": {
      "enum": [
        "technical-engineer",
        "software-developer",
        "art-designer",
        "entrepreneur-operator",
        "investor-capital-allocator",
        "thinker-educator",
        "political-legal",
        "customer-marketing",
        "construction-procurement",
        "finance-compliance",
        "healthcare-nursing",
        "agriculture-fishery"
      ]
    },
    "weights": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "maximum": 1,
        "type": "number"
      },
      "minProperties": 1,
      "type": "object"
    }
  },
  "required": [
    "mode",
    "primary",
    "weights",
    "canonical"
  ],
  "title": "Identity selection",
  "type": "object"
}
