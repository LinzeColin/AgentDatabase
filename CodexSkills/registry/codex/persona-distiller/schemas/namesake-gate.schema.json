{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LinzeColin/AgentDatabase/CodexSkills/registry/codex/persona-distiller/schemas/namesake-gate.schema.json",
  "title": "Persona Distiller namesake disambiguation gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_name",
    "normalized_name",
    "status",
    "resolution",
    "candidate_count",
    "candidates",
    "candidate_cards",
    "selected_subject_uid"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "target_name": { "type": "string", "minLength": 1 },
    "normalized_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ready", "blocked"] },
    "resolution": { "enum": ["none", "single", "multiple"] },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "selected_subject_uid": { "type": ["string", "null"] },
    "generated_at": { "type": "string" },
    "search_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidate_cards": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "canonical_name",
          "identity_category",
          "occupation_or_role",
          "professional_background",
          "application_scenarios",
          "key_capabilities",
          "distinguishing_basis",
          "authoritative_sources",
          "evidence_level"
        ],
        "properties": {
          "label": { "type": "string", "pattern": "^[A-Z]+$" },
          "canonical_name": { "type": "string", "minLength": 1 },
          "subject_uid": { "type": ["string", "null"] },
          "identity_category": { "type": "string", "minLength": 1 },
          "occupation_or_role": { "type": "string", "minLength": 1 },
          "professional_background": { "type": "string", "minLength": 1 },
          "application_scenarios": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "key_capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "distinguishing_basis": { "type": "string", "minLength": 1 },
          "authoritative_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator"],
              "properties": {
                "locator": { "type": "string", "minLength": 1 },
                "title": { "type": "string" },
                "publisher": { "type": "string" },
                "date": { "type": "string" },
                "evidence": { "type": "string" }
              }
            }
          },
          "evidence_level": { "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
