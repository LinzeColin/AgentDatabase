{
  "schema_version": "2.0",
  "input": {
    "format": "jsonl",
    "required_fields": [
      "assignment_id",
      "experiment_id",
      "task_id",
      "partition",
      "repetition",
      "sequence",
      "condition_code",
      "prompt",
      "oracle"
    ]
  },
  "output": {
    "format": "jsonl",
    "required_fields": [
      "experiment_id",
      "run_id",
      "task_id",
      "partition",
      "arm_id",
      "repetition",
      "status",
      "outcome",
      "usage",
      "evidence_kind",
      "artifact_digest",
      "environment",
      "trace_digest",
      "protected",
      "hard_failures"
    ]
  },
  "rules": [
    "执行器没有裁决权，只产生原始观察。",
    "控制器负责 condition_code 到 arm_id 的映射；Candidate 和评委不得读取 blind map。",
    "任何 NOT_RUN、BLOCKED、timeout 或缺失证据不得归一化为 PASS。",
    "结果必须绑定精确制品、模型、运行时、任务和 trace digest。",
    "所有实验臂必须绑定相同的冻结环境字段；不可消除差异必须由 quality-audit 阻断或降级。",
    "Gate 必须同时绑定 SUMMARY.json 与 QUALITY_AUDIT.json；缺少任一者不得输出证据就绪。"
  ],
  "environment_contract": {
    "required_fields": [
      "model_snapshot",
      "runtime_version",
      "tools",
      "permissions",
      "budget",
      "system_digest",
      "dataset_digest"
    ],
    "same_within_paired_unit": true,
    "block_on_mismatch": true
  },
  "egress_contract": {
    "default": "deny",
    "provider_allowlist": [],
    "raw_private_content": false
  }
}
