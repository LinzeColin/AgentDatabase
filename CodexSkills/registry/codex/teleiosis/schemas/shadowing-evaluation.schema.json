{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teleiosis Skill Library Shadowing Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "shadowing_status",
    "records",
    "metrics",
    "thresholds",
    "confusion_pairs",
    "blockers",
    "unknowns",
    "claim_boundary",
    "shadowing_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "shadowing_status": {
      "enum": [
        "PASS",
        "SHADOWING_RISK"
      ]
    },
    "records": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "required": [
        "top1_selection_accuracy",
        "topk_recall",
        "false_activation_rate",
        "mean_library_outcome_delta",
        "outcome_delta_observations"
      ]
    },
    "thresholds": {
      "type": "object"
    },
    "confusion_pairs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_boundary": {
      "type": "string"
    },
    "shadowing_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
