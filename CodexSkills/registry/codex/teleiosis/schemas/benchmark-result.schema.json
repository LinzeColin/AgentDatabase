{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teleiosis.local/schemas/benchmark-result.schema.json",
  "title": "Raw benchmark result bound to exact system, target, dataset and trace",
  "type": "object",
  "required": [
    "result_id", "system_id", "system_tree_hash", "target_id", "target_tree_hash",
    "track", "split", "trial", "runtime", "model", "metrics", "hard_gates", "budget",
    "raw_result_path", "raw_result_sha256", "process_trace_path", "process_trace_sha256"
  ],
  "properties": {
    "budget": {
      "type": "object",
      "required": [
        "token_evidence_status", "model_tokens", "calls", "wall_seconds", "human_minutes",
        "monetary_cost_status", "monetary_cost"
      ],
      "properties": {
        "token_evidence_status": {"enum": ["MEASURED", "ESTIMATED", "UNKNOWN"]},
        "model_tokens": {"type": ["number", "null"], "minimum": 0},
        "calls": {"type": "number", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0},
        "human_minutes": {"type": "number", "minimum": 0},
        "monetary_cost_status": {"enum": ["MEASURED", "ESTIMATED", "UNKNOWN"]},
        "monetary_cost": {"type": ["number", "null"], "minimum": 0}
      }
    }
  },
  "additionalProperties": true
}
