{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White-Box Iteration Genesis Requirement Coverage",
  "type": "object",
  "required": ["baseline_id", "baseline_hash", "valid_as_of", "requirements"],
  "properties": {
    "baseline_id": {"type": "string"},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "valid_as_of": {"type": "string", "format": "date"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence_bindings"],
        "properties": {
          "id": {"type": "string", "pattern": "^WBI-GB-[0-9]{3}$"},
          "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN", "FAIL"]},
          "evidence_bindings": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "bytes"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "bytes": {"type": "integer", "minimum": 0}
              }
            }
          },
          "unknowns": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
