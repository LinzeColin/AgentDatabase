{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider-Attested Independent White-Box Review Record",
  "type": "object",
  "required": ["packet_id", "panel", "role", "actor_id", "context_id", "provider_run_id", "mode", "context_isolated", "saw_other_reviews_before_submission", "verdict", "findings", "evidence_bindings", "attestation"],
  "properties": {
    "mode": {"const": "independent-subagent"},
    "context_isolated": {"const": true},
    "saw_other_reviews_before_submission": {"const": false},
    "verdict": {"enum": ["PASS", "CONDITIONAL", "FAIL"]},
    "attestation": {
      "type": "object",
      "required": ["type", "verification_status", "receipt_path", "receipt_sha256"],
      "properties": {
        "type": {"enum": ["provider-signed-receipt", "runtime-tool-receipt"]},
        "verification_status": {"const": "VERIFIED"}
      }
    }
  },
  "additionalProperties": true
}
