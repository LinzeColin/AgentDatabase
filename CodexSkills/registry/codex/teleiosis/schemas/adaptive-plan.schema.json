{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teleiosis.local/schemas/adaptive-plan.schema.json",
  "title": "Evidence-derived adaptive optimization plan",
  "type": "object",
  "required": ["schema_version", "plan_status", "run_mode", "target_binding", "profile", "candidate_portfolio", "budget", "required_gates", "negative_optimization_guard", "next_action"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_status": {"enum": ["READY", "BLOCKED"]},
    "run_mode": {"enum": ["diagnostic", "engineering", "formal"]},
    "candidate_portfolio": {"type": "array", "items": {"type": "object"}},
    "required_gates": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
