{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teleiosis Current Environment Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "snapshot_status",
    "valid_as_of",
    "timezone",
    "expires_at",
    "identity",
    "runtime",
    "evidence",
    "missing_strength_evidence",
    "blockers",
    "unknowns",
    "reheat_triggers",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "valid_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "validity_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "required": [
        "target_path",
        "target_tree_sha256",
        "optimizer_path",
        "optimizer_tree_sha256"
      ]
    },
    "runtime": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "missing_strength_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reheat_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
