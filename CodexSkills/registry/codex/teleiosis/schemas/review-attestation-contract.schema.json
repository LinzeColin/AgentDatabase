{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teleiosis.local/schemas/review-attestation-contract.schema.json",
  "title": "External independent 2x6+1 review attestation contract",
  "type": "object",
  "required": [
    "schema_version", "status", "provider", "adapter_version", "deployment_identity",
    "adapter_path", "adapter_sha256", "receipt_root", "capabilities",
    "candidate_can_write_receipts", "candidate_can_access_signing_key", "shell_execution",
    "attestation_mode", "formal_attestation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "FROZEN"},
    "attestation_mode": {"enum": ["FORMAL_EXTERNAL", "DIAGNOSTIC_FIXTURE"]},
    "trust_mode": {"enum": ["ED25519_SIGNED_RECEIPTS", "DIAGNOSTIC_FIXTURE"]},
    "signature_algorithm": {"enum": ["ed25519", null]},
    "candidate_can_write_receipts": {"const": false},
    "candidate_can_access_signing_key": {"const": false},
    "shell_execution": {"const": false},
    "formal_attestation": {"type": "boolean"},
    "trust_anchor_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
