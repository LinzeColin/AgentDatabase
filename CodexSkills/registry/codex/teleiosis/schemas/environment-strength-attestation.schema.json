{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teleiosis Current Environment Strength Attestation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "environment_strength_status",
    "checked_at",
    "selected_candidate",
    "pareto_frontier",
    "comparison_set_size",
    "environment_snapshot",
    "candidate_set",
    "evidence_lease",
    "required_evidence_states",
    "reasons",
    "unknowns",
    "claim_boundary",
    "attestation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "environment_strength_status": {
      "enum": [
        "PARETO_UNDOMINATED_FOR_VERIFIED_CURRENT_ENVIRONMENT",
        "NOT_PROVEN",
        "REGRESSED",
        "BLOCKED",
        "REHEAT_REQUIRED"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "selected_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "pareto_frontier": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comparison_set_size": {
      "type": "integer",
      "minimum": 0
    },
    "environment_snapshot": {
      "$ref": "#/$defs/binding"
    },
    "candidate_set": {
      "$ref": "#/$defs/binding"
    },
    "evidence_lease": {
      "type": "object",
      "required": [
        "valid_from",
        "expires_at",
        "valid_now",
        "reheat_triggers"
      ]
    },
    "required_evidence_states": {
      "type": "object"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
