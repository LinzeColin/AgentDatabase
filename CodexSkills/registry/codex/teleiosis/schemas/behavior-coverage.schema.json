{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teleiosis Behavior Coverage Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "coverage_status",
    "constraints",
    "trajectories",
    "metrics",
    "thresholds",
    "uncovered",
    "hard_uncovered",
    "failed",
    "unknown_constraint_references",
    "claim_boundary",
    "coverage_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "coverage_status": {
      "enum": [
        "PASS",
        "INCOMPLETE"
      ]
    },
    "constraints": {
      "type": "object"
    },
    "trajectories": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "required": [
        "overall_behavior_coverage",
        "hard_behavior_coverage",
        "exercised_constraints",
        "satisfied_constraints",
        "failed_constraints",
        "uncovered_constraints"
      ]
    },
    "thresholds": {
      "type": "object"
    },
    "uncovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard_uncovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_constraint_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_boundary": {
      "type": "string"
    },
    "coverage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
