{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teleiosis.local/schemas/target-diagnostic.schema.json",
  "title": "Bounded no-exec target diagnosis",
  "type": "object",
  "required": ["schema_version", "diagnostic_status", "valid_as_of", "target", "classification", "capabilities", "blockers", "warnings", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "diagnostic_status": {"enum": ["PASS", "WARN", "BLOCKED"]},
    "target": {
      "type": "object",
      "required": ["path", "tree_sha256", "file_count", "scanned_file_count"]
    },
    "classification": {
      "type": "object",
      "required": ["target_class", "risk_level", "suggested_verification_level", "evidence_completeness"]
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
