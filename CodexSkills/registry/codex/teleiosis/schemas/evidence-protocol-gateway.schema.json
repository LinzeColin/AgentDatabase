{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Protocol Gateway",
  "type": "object",
  "required": [
    "schema_version",
    "protocols"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "protocol_id",
          "trust_boundary",
          "allowed_claims",
          "forbidden_claims"
        ]
      }
    }
  }
}
