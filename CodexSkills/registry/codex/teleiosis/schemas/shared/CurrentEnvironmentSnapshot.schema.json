{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teleiosis.current_environment_snapshot.v3",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "snapshot_id",
    "valid_as_of",
    "timezone",
    "candidate_hash",
    "acceptance_hash",
    "environment_hash",
    "models",
    "tools",
    "permissions",
    "network",
    "budget",
    "peer_set",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "teleiosis.current_environment_snapshot.v3"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 3
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptance_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "models": {
      "type": "array"
    },
    "tools": {
      "type": "array"
    },
    "permissions": {
      "type": "array"
    },
    "network": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "peer_set": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    }
  }
}
