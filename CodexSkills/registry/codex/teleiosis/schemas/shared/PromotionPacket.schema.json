{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teleiosis://shared/PromotionPacket/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_identity",
    "teleiosis_result",
    "market_result",
    "product_result",
    "rollback_target_hash",
    "residual_risks"
  ],
  "properties": {
    "candidate_identity": {
      "$ref": "teleiosis://shared/CandidateIdentity/v1"
    },
    "teleiosis_result": {
      "type": "object"
    },
    "market_result": {
      "type": "object"
    },
    "product_result": {
      "type": "object"
    },
    "rollback_target_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "residual_risks": {
      "type": "array"
    }
  }
}
