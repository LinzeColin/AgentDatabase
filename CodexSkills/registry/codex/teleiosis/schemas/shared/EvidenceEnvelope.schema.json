{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teleiosis://shared/EvidenceEnvelope/v1",
  "title": "EvidenceEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "candidate_hash",
    "evidence_class",
    "source",
    "captured_at",
    "oracle",
    "artifact_hash",
    "actor",
    "cost",
    "latency_ms"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_class": {
      "enum": [
        "SYNTHETIC",
        "CONTROLLED_HUMAN",
        "FIELD_OBSERVED"
      ]
    },
    "source": {
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    },
    "oracle": {
      "type": "string"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string"
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    }
  }
}
