{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teleiosis.local/schemas/status-summary.schema.json",
  "title": "Teleiosis evidence-domain status summary",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "domains",
    "cost_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "identity": {
      "type": "object",
      "required": [
        "run_id",
        "candidate_id",
        "candidate_tree_hash",
        "valid_as_of"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_tree_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "valid_as_of": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "domains": {
      "type": "object",
      "required": [
        "control_plane_status",
        "benchmark_integrity_status",
        "outcome_status",
        "cost_evidence_status",
        "independent_review_status",
        "engineering_release_status",
        "formal_promotion_status",
        "current_environment_strength_status"
      ]
    },
    "cost_evidence": {
      "type": "object",
      "required": [
        "total_tokens",
        "known_total_tokens",
        "unknown_token_invocations",
        "total_monetary_cost",
        "known_monetary_cost",
        "unknown_cost_invocations",
        "currency"
      ],
      "properties": {
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "known_total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_token_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "total_monetary_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "known_monetary_cost": {
          "type": "number",
          "minimum": 0
        },
        "unknown_cost_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimation_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": true
}
