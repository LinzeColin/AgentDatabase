{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linzezhang.com/schemas/teleiosis/peer-taxonomy-1.0.json",
  "title": "Teleiosis Peer Taxonomy Audit",
  "type": "object",
  "required": ["schema_version", "status", "records", "policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["PASS", "FAIL"]},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["comparison_scope", "market_scope_eligible", "market_peer_eligible"],
        "properties": {
          "comparison_scope": {
            "enum": ["direct-competitor", "adjacent-competitor", "method-reference", "engineering-analogy", "out-of-scope"]
          },
          "market_scope_eligible": {"type": "boolean"},
          "market_peer_eligible": {"type": "boolean"}
        }
      }
    },
    "policy": {"type": "object"}
  }
}
