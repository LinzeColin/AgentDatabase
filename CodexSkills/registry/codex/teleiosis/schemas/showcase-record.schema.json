{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teleiosis.local/schemas/showcase-record.schema.json",
  "title": "Truthful showcase generation receipt",
  "type": "object",
  "required": ["status", "output", "sha256", "bytes", "leadership_label", "claim_boundary"],
  "properties": {
    "status": {"const": "PASS"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true
}
