{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linzezhang.com/schemas/teleiosis/verifier-export-1.0.json",
  "title": "Teleiosis External Verifier Request",
  "type": "object",
  "required": ["schema_version", "request_type", "subject", "acceptance_items", "verdict_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_type": {"const": "independent-read-only-skill-acceptance"},
    "subject": {"type": "object"},
    "acceptance_items": {"type": "array", "minItems": 1},
    "verdict_policy": {"type": "object"}
  }
}
