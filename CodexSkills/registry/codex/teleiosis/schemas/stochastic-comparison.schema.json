{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teleiosis Stochastic Comparison Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "stochastic_decision",
    "results",
    "baseline_id",
    "candidate_id",
    "minimum_trials",
    "minimum_effect",
    "statistics",
    "reasons",
    "claim_boundary",
    "comparison_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stochastic_decision": {
      "enum": [
        "SUPPORTED",
        "REGRESSED",
        "INCONCLUSIVE"
      ]
    },
    "results": {
      "type": "object"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "minimum_trials": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_effect": {
      "type": "number"
    },
    "statistics": {
      "type": "object"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claim_boundary": {
      "type": "string"
    },
    "comparison_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
