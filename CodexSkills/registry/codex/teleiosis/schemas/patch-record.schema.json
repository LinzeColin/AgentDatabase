{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White-Box Iteration Change Input",
  "type": "object",
  "required": ["hypothesis", "evidence_paths", "actor_id", "commands", "tools", "risk", "decision"],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "raw_result_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "actor_id": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "models": {"type": "array", "items": {"type": "string"}},
    "agents": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"},
    "risk": {"type": "array"},
    "unknowns": {"type": "array"},
    "decision": {"enum": ["KEEP", "REVERT", "NO_CHANGE"]},
    "architecture_reset": {"type": "boolean"}
  },
  "additionalProperties": true
}
