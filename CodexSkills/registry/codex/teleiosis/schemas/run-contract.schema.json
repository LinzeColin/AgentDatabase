{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White-Box Iteration Run Contract",
  "type": "object",
  "required": [
    "schema_version", "run_id", "goal", "scope", "non_goals", "hard_requirements",
    "knowns", "unknowns", "dependencies", "risks", "acceptance_criteria", "user_constraints"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1},
    "non_goals": {"type": "array", "minItems": 1},
    "hard_requirements": {"type": "array", "minItems": 1},
    "knowns": {"type": "array"},
    "unknowns": {"type": "array"},
    "dependencies": {"type": "array"},
    "risks": {"type": "array"},
    "acceptance_criteria": {"type": "array", "minItems": 1},
    "user_constraints": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
