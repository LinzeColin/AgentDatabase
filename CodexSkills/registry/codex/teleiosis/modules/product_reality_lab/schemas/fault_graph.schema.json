{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/fault-graph.schema.json",
  "title": "Fault Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "steady_states",
    "faults",
    "experiments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "steady_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "oracle_ids",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "oracle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "target",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "expected_effect": {
            "type": "string"
          },
          "expected_recovery": {
            "type": "string"
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fault_id",
          "steady_state_id",
          "blast_radius",
          "abort",
          "rollback",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fault_id": {
            "type": "string"
          },
          "steady_state_id": {
            "type": "string"
          },
          "blast_radius": {
            "type": "string"
          },
          "abort": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "RUNNING",
              "OBSERVED_EXPECTED",
              "OBSERVED_DEVIATION",
              "ABORTED",
              "ROLLED_BACK",
              "WAIVED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
