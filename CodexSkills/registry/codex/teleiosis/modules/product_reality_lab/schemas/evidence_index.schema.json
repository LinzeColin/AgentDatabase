{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/evidence-index.schema.json",
  "title": "Evidence Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "path",
          "sha256",
          "kind",
          "created_at",
          "subject_ref"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "subject_ref": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "SYNTHETIC",
              "CONTROLLED_HUMAN",
              "FIELD_OBSERVED"
            ]
          }
        }
      }
    }
  }
}
