{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/competitor-evidence.schema.json",
  "title": "Competitor Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "references",
    "benchmark_tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "competitor_id",
          "name",
          "class",
          "sources"
        ],
        "properties": {
          "competitor_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "class": {
            "type": "string",
            "enum": [
              "DIRECT",
              "ADJACENT",
              "SUBSTITUTE",
              "MANUAL_WORKAROUND",
              "OSS_ANALOGUE"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "url",
                "source_type",
                "accessed_at",
                "public_or_authorized",
                "claim",
                "confidence",
                "evidence_ref"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "source_type": {
                  "type": "string"
                },
                "accessed_at": {
                  "type": "string"
                },
                "published_or_version_date": {
                  "type": "string"
                },
                "public_or_authorized": {
                  "type": "boolean"
                },
                "claim": {
                  "type": "string"
                },
                "evidence_excerpt_or_summary": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence_ref": {
                  "type": "string"
                }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "known_pain_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "benchmark_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "task",
          "starting_state",
          "inputs",
          "metrics",
          "results",
          "evidence_refs"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "starting_state": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "results": {
            "type": "object"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "capability",
          "decision",
          "rationale",
          "owner",
          "evidence_refs"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "ADOPT",
              "ADAPT",
              "DIFFERENTIATE",
              "REJECT",
              "DEFER"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
