{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/inventory-diff.schema.json",
  "title": "Inventory Diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_only",
    "runtime_only",
    "unwaived_count",
    "waivers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "source_only": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "runtime_only": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unwaived_count": {
      "type": "integer",
      "minimum": 0
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
