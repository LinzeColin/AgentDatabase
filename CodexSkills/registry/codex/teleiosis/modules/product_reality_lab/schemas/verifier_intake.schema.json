{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/verifier-intake.schema.json",
  "title": "Verifier Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "run_id",
    "subject",
    "run_contract_sha256",
    "coverage_status",
    "evidence_index_sha256",
    "open_p0",
    "open_p1",
    "field_validation",
    "residual_risk_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "status": {
      "type": "string",
      "const": "READY_FOR_VERIFIER"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "subject": {
      "type": "object"
    },
    "run_contract_sha256": {
      "type": "string"
    },
    "coverage_status": {
      "type": "object"
    },
    "evidence_index_sha256": {
      "type": "string"
    },
    "open_p0": {
      "type": "integer",
      "const": 0
    },
    "open_p1": {
      "type": "integer",
      "const": 0
    },
    "field_validation": {
      "type": "object"
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "residual_risk_ref": {
      "type": "string"
    },
    "tool_manifest": {
      "type": "array"
    },
    "model_manifest": {
      "type": "array"
    },
    "readiness_calculation_version": {
      "type": "string"
    }
  }
}
