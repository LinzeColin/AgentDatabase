{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/run-contract.schema.json",
  "title": "Product Reality Lab Run Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "subject",
    "scope",
    "environment",
    "authorization",
    "budget",
    "field_validation_required",
    "evidence_root",
    "competitor_research_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ref",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "commit",
            "deployment",
            "artifact",
            "workspace",
            "other"
          ]
        },
        "repository": {
          "type": "string"
        },
        "deployment_url": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "non_goals"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tenants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "feature_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "browsers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timezones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "risk_tier",
        "disposable"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "risk_tier": {
          "type": "string",
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "disposable": {
          "type": "boolean"
        },
        "contains_real_money": {
          "type": "boolean"
        },
        "contains_personal_data": {
          "type": "boolean"
        },
        "rollback_procedure": {
          "type": "string"
        },
        "backup_evidence_ref": {
          "type": "string"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "active_security_allowed",
        "load_allowed",
        "chaos_allowed",
        "destructive_actions_allowed"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "active_security_allowed": {
          "type": "boolean"
        },
        "load_allowed": {
          "type": "boolean"
        },
        "chaos_allowed": {
          "type": "boolean"
        },
        "destructive_actions_allowed": {
          "type": "boolean"
        },
        "competitor_automation_allowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_tokens",
        "max_duration_minutes"
      ],
      "properties": {
        "max_model_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_currency": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "kill_switch_notes": {
          "type": "string"
        }
      }
    },
    "field_validation_required": {
      "type": "boolean"
    },
    "evidence_root": {
      "type": "string",
      "minLength": 1
    },
    "tool_manifest": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "model_manifest": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "competitor_research_required": {
      "type": "boolean"
    }
  }
}
