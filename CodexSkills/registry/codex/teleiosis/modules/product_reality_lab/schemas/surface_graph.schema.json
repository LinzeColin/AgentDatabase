{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/surface-graph.schema.json",
  "title": "Product Surface Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "source_visibility",
          "runtime_visibility",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "route",
              "page",
              "component",
              "control",
              "api",
              "job",
              "queue",
              "event",
              "database",
              "report",
              "dependency",
              "task",
              "other"
            ]
          },
          "name": {
            "type": "string"
          },
          "source_visibility": {
            "type": "boolean"
          },
          "runtime_visibility": {
            "type": "boolean"
          },
          "critical": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "waiver_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "action",
          "critical",
          "destructive"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "destructive": {
            "type": "boolean"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "oracle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "waiver_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
