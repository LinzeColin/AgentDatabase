{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/journey-state-graph.schema.json",
  "title": "Journey State Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "states",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "task",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          },
          "auth": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fixture": {
            "type": "string"
          },
          "browser_device": {
            "type": "string"
          },
          "locale_timezone": {
            "type": "string"
          },
          "world_state_digest": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "action",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "failure_mode": {
            "type": "string"
          },
          "recovery_transition_id": {
            "type": "string"
          },
          "oracle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
