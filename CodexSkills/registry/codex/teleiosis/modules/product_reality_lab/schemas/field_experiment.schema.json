{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/field-experiment.schema.json",
  "title": "Field Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "required",
    "experiments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "stage",
          "hypothesis",
          "segment",
          "primary_metric",
          "guardrail_metrics",
          "rollback_trigger",
          "evidence_class",
          "status"
        ],
        "properties": {
          "experiment_id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "DOGFOOD",
              "CONTROLLED_TASK",
              "CLOSED_BETA",
              "CANARY",
              "SEGMENTED_ROLLOUT"
            ]
          },
          "hypothesis": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "feature_flag": {
            "type": "string"
          },
          "primary_metric": {
            "type": "string"
          },
          "guardrail_metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minimum_evidence_rule": {
            "type": "string"
          },
          "rollback_trigger": {
            "type": "string"
          },
          "privacy_masking": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "CONTROLLED_HUMAN",
              "FIELD_OBSERVED"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "RUNNING",
              "STOPPED",
              "COMPLETED",
              "ROLLED_BACK"
            ]
          },
          "results": {
            "type": "object"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
