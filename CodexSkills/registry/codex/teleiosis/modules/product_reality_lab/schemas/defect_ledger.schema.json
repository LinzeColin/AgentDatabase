{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/defect-ledger.schema.json",
  "title": "Defect Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "defects"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defect_id",
          "title",
          "severity",
          "status",
          "expectation_source",
          "minimal_reproduction",
          "expected",
          "actual",
          "impact",
          "evidence_refs"
        ],
        "properties": {
          "defect_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "TRIAGED",
              "FIX_IN_PROGRESS",
              "FIXED_UNVERIFIED",
              "CLOSED",
              "WAIVED",
              "DUPLICATE",
              "INVALID"
            ]
          },
          "expectation_source": {
            "type": "string"
          },
          "source_method": {
            "type": "string"
          },
          "minimal_reproduction": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "subject_ref": {
            "type": "string"
          },
          "root_cause": {
            "type": "string"
          },
          "root_cause_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "owner": {
            "type": "string"
          },
          "fix_ref": {
            "type": "string"
          },
          "regression_oracle": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "SYNTHETIC",
              "CONTROLLED_HUMAN",
              "FIELD_OBSERVED"
            ]
          }
        }
      }
    }
  }
}
