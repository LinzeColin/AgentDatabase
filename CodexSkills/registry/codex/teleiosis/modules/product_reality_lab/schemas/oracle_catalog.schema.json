{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linze.local/schemas/product-reality-lab/oracle-catalog.schema.json",
  "title": "Oracle Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "oracles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "oracles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "oracle_id",
          "type",
          "claim",
          "independent_from_generator",
          "procedure",
          "critical"
        ],
        "properties": {
          "oracle_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "independent_from_generator": {
            "type": "boolean"
          },
          "procedure": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "critical": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
