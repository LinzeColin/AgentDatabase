{
  "schema_version": "1.0",
  "protocols": [
    {
      "protocol_id": "github-source",
      "trust_boundary": "public immutable commit or archived tree",
      "allowed_claims": [
        "source identity",
        "file inventory"
      ],
      "forbidden_claims": [
        "runtime outcome",
        "formal independent review"
      ]
    },
    {
      "protocol_id": "local-zip",
      "trust_boundary": "received bytes plus sha256",
      "allowed_claims": [
        "artifact identity"
      ],
      "forbidden_claims": [
        "source provenance without separate evidence"
      ]
    },
    {
      "protocol_id": "provider-receipt",
      "trust_boundary": "external provider run id plus signature when available",
      "allowed_claims": [
        "invocation identity",
        "usage evidence"
      ],
      "forbidden_claims": [
        "verdict without reviewer packet binding"
      ]
    },
    {
      "protocol_id": "verifier-evidence",
      "trust_boundary": "sealed acceptance run",
      "allowed_claims": [
        "acceptance verdict for exact subject"
      ],
      "forbidden_claims": [
        "builder self-attestation"
      ]
    }
  ]
}
