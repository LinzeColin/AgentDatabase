{
  "name": "micro_performance",
  "purpose": "subtle human performance and dialogue",
  "priorities": [
    "trigger",
    "breath",
    "gaze",
    "blink",
    "facial_asymmetry",
    "hands_shoulders_weight",
    "dialogue_timing",
    "reaction_after_trigger",
