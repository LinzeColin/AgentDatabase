{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoryatlas.linzezhang.com/schema/memory_atlas.live_snapshot.v1.schema.json",
  "title": "Memory Atlas LiveSnapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "run",
    "release",
    "freshness",
    "coverage",
    "analysis",
    "decision",
    "visuals",
    "benchmarks",
    "truth",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "memory_atlas.live_snapshot.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "trace_id",
        "source_state",
        "source_started_at",
        "source_completed_at",
        "reconciled_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 8
        },
        "trace_id": {
          "type": "string",
          "minLength": 8
        },
        "source_state": {
          "enum": [
            "SUCCEEDED",
            "REBUILT_FROM_AUTHORITIES"
          ]
        },
        "source_started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reconciled_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_state",
        "repository_commit",
        "release_id",
        "artifact_digest",
        "deployment_revision"
      ],
      "properties": {
        "identity_state": {
          "enum": [
            "VERIFIED",
            "OBSERVED",
            "UNVERIFIED"
          ]
        },
        "repository_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "release_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        },
        "deployment_revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evaluated_at",
        "age_seconds",
        "target_seconds",
        "reason_zh"
      ],
      "properties": {
        "state": {
          "enum": [
            "FRESH",
            "DEGRADED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "target_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "reason_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_state",
        "tier_a_cloud_native",
        "tier_b_local_optional",
        "sources"
      ],
      "properties": {
        "product_state": {
          "enum": [
            "PASS",
            "DEGRADED",
            "WAITING_SOURCE",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "tier_a_cloud_native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "total",
            "stale",
            "missing",
            "failed",
            "unknown"
          ],
          "properties": {
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "stale": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tier_b_local_optional": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "total",
            "stale",
            "missing",
            "failed",
            "unknown"
          ],
          "properties": {
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "stale": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "label_zh",
              "tier",
              "required_for_capture",
              "required_for_product",
              "state",
              "object_count",
              "size_bytes",
              "last_observed_at"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "label_zh": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "enum": [
                  "A_CLOUD_NATIVE",
                  "B_LOCAL_OPTIONAL"
                ]
              },
              "required_for_capture": {
                "type": "boolean"
              },
              "required_for_product": {
                "type": "boolean"
              },
              "state": {
                "enum": [
                  "READY",
                  "STALE",
                  "MISSING",
                  "FAILED",
                  "UNKNOWN"
                ]
              },
              "object_count": {
                "type": "integer",
                "minimum": 0
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "last_observed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "event_window",
        "activity_distribution",
        "outcome_distribution",
        "verified_outcome_rate_event",
        "verified_outcome_rate_work_time",
        "work_time_coverage_rate",
        "outcome_evidence_coverage_rate",
        "verification_debt_proxy_event",
        "legacy_verified_outcome_rate",
        "failure_compound"
      ],
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "event_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_at",
            "end_at"
          ],
          "properties": {
            "start_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "end_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "activity_distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label_zh",
              "count",
              "share"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label_zh": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "share": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "outcome_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "verified_outcome_rate_event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "numerator",
            "denominator",
            "denominator_basis",
            "label_zh",
            "proxy"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "numerator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator_basis": {
              "type": "string",
              "minLength": 1
            },
            "label_zh": {
              "type": "string",
              "minLength": 1
            },
            "proxy": {
              "type": "boolean"
            }
          }
        },
        "verified_outcome_rate_work_time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "numerator",
            "denominator",
            "denominator_basis",
            "label_zh",
            "proxy"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "numerator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator_basis": {
              "type": "string",
              "minLength": 1
            },
            "label_zh": {
              "type": "string",
              "minLength": 1
            },
            "proxy": {
              "type": "boolean"
            }
          }
        },
        "work_time_coverage_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "numerator",
            "denominator",
            "denominator_basis",
            "label_zh",
            "proxy"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "numerator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator_basis": {
              "type": "string",
              "minLength": 1
            },
            "label_zh": {
              "type": "string",
              "minLength": 1
            },
            "proxy": {
              "type": "boolean"
            }
          }
        },
        "outcome_evidence_coverage_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "numerator",
            "denominator",
            "denominator_basis",
            "label_zh",
            "proxy"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "numerator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator_basis": {
              "type": "string",
              "minLength": 1
            },
            "label_zh": {
              "type": "string",
              "minLength": 1
            },
            "proxy": {
              "type": "boolean"
            }
          }
        },
        "verification_debt_proxy_event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "numerator",
            "denominator",
            "denominator_basis",
            "label_zh",
            "proxy"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "numerator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "denominator_basis": {
              "type": "string",
              "minLength": 1
            },
            "label_zh": {
              "type": "string",
              "minLength": 1
            },
            "proxy": {
              "type": "boolean"
            }
          }
        },
        "legacy_verified_outcome_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "denominator_basis",
            "compatibility_only"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "denominator_basis": {
              "type": "string"
            },
            "compatibility_only": {
              "const": true
            }
          }
        },
        "failure_compound": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compound_score",
            "incident_count",
            "historical_recurrences",
            "blocked_recurrences"
          ],
          "properties": {
            "compound_score": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "incident_count": {
              "type": "integer",
              "minimum": 0
            },
            "historical_recurrences": {
              "type": "integer",
              "minimum": 0
            },
            "blocked_recurrences": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_use",
        "verified_results",
        "low_value_loop",
        "top_action"
      ],
      "properties": {
        "primary_use": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "title_zh",
            "detail_zh"
          ],
          "properties": {
            "title_zh": {
              "type": "string",
              "minLength": 1
            },
            "detail_zh": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "verified_results": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "title_zh",
            "detail_zh"
          ],
          "properties": {
            "title_zh": {
              "type": "string",
              "minLength": 1
            },
            "detail_zh": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "low_value_loop": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "title_zh",
            "detail_zh"
          ],
          "properties": {
            "title_zh": {
              "type": "string",
              "minLength": 1
            },
            "detail_zh": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "top_action": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "title_zh",
            "detail_zh"
          ],
          "properties": {
            "title_zh": {
              "type": "string",
              "minLength": 1
            },
            "detail_zh": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "visuals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title_zh",
          "kind",
          "rows"
        ],
        "properties": {
          "id": {
            "enum": [
              "quality_contribution_grid",
              "verification_debt_trend",
              "task_tool_outcome_heatmap"
            ]
          },
          "title_zh": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "GRID",
              "TREND",
              "HEATMAP"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "quality_contribution_grid"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "verification_debt_trend"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "task_tool_outcome_heatmap"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "comparisons",
        "limitations"
      ],
      "properties": {
        "state": {
          "enum": [
            "DIRECTLY_COMPARABLE",
            "DIRECTION_ONLY",
            "NOT_COMPARABLE",
            "INSUFFICIENT_DATA"
          ]
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_contract_version",
        "same_run_evidence",
        "historical_snapshot_role",
        "limitations"
      ],
      "properties": {
        "metric_contract_version": {
          "const": "memory_atlas.metric_contract.v1"
        },
        "same_run_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "r2_readback",
            "private_database_readback",
            "ovh_reconcile",
            "status_projection"
          ],
          "properties": {
            "r2_readback": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "run_id",
                "trace_id",
                "ref"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN",
                    "UNKNOWN"
                  ]
                },
                "run_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "trace_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "private_database_readback": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "run_id",
                "trace_id",
                "ref"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN",
                    "UNKNOWN"
                  ]
                },
                "run_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "trace_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "ovh_reconcile": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "run_id",
                "trace_id",
                "ref"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN",
                    "UNKNOWN"
                  ]
                },
                "run_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "trace_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "status_projection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "run_id",
                "trace_id",
                "ref"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN",
                    "UNKNOWN"
                  ]
                },
                "run_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "trace_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "historical_snapshot_role": {
          "const": "HISTORICAL_ATLAS_ONLY_NOT_LIVE_TRUTH"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_content_included",
        "secret_values_included",
        "private_paths_included",
        "object_keys_included"
      ],
      "properties": {
        "raw_content_included": {
          "const": false
        },
        "secret_values_included": {
          "const": false
        },
        "private_paths_included": {
          "const": false
        },
        "object_keys_included": {
          "const": false
        }
      }
    }
  }
}
