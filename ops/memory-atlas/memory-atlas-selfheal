#!/usr/bin/env bash
set -euo pipefail
STATE_DIR=${MEMORY_ATLAS_RUNTIME_DIR:-/srv/linze/state/memory-atlas}
LOCK="$STATE_DIR/selfheal.lock"
LOG="$STATE_DIR/selfheal.jsonl"
mkdir -p "$STATE_DIR"
exec 9>"$LOCK"
flock -n 9 || exit 0
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
status="PASS"
action="none"
reason="healthy"
if ! systemctl is-active --quiet memory-atlas-api.service; then
  action="restart-api"
  # A unit in start-limit-hit refuses every further start until the failed
  # state is cleared, so restarting it without this does nothing but burn the
  # next window's budget and report FAILED.
  systemctl reset-failed memory-atlas-api.service 2>/dev/null || true
  systemctl restart memory-atlas-api.service
  sleep 2
  if ! systemctl is-active --quiet memory-atlas-api.service; then
    status="FAILED"
    reason="api_not_recovered_after_one_restart"
  fi
fi
if [[ "$status" == "PASS" ]] && ! curl --fail --silent --max-time 5 http://127.0.0.1:8766/healthz >/dev/null; then
  action="restart-api-after-probe"
  systemctl restart memory-atlas-api.service
  sleep 2
  if ! curl --fail --silent --max-time 5 http://127.0.0.1:8766/healthz >/dev/null; then
    status="FAILED"
    reason="health_probe_not_recovered"
  fi
fi
if [[ "$status" == "PASS" ]] && ! curl --fail --silent --max-time 5 http://10.0.0.1:18766/healthz >/dev/null; then
  action="restart-api-proxy-after-probe"
  systemctl restart memory-atlas-api-proxy.socket
  sleep 2
  if ! curl --fail --silent --max-time 5 http://10.0.0.1:18766/healthz >/dev/null; then
    status="FAILED"
    reason="api_proxy_probe_not_recovered"
  fi
fi
printf '{"schema_version":"memory_atlas.selfheal.v1","at":"%s","state":"%s","action":"%s","reason":"%s"}\n' \
  "$now" "$status" "$action" "$reason" >> "$LOG"
[[ "$status" == "PASS" ]]
