[Unit]
Description=Memory Atlas bounded diagnosis and self-heal
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/srv/linze/secrets/memory-atlas.env
Environment=GH_CONFIG_DIR=/srv/linze/state/memory-atlas/gh-config
WorkingDirectory=/srv/linze/apps/agentdatabase/current
ExecStart=/usr/local/bin/memory-atlas-selfheal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/linze/state/memory-atlas /srv/linze/work/memory-atlas /srv/linze/apps/memory-atlas/shared/data
UMask=0077
TimeoutStartSec=10min
