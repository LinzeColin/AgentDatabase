[Unit]
Description=Memory Atlas private analytics API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/srv/linze/secrets/memory-atlas.env
Environment=GH_CONFIG_DIR=/srv/linze/state/memory-atlas/gh-config
WorkingDirectory=/srv/linze/apps/agentdatabase/current
ExecStart=/srv/linze/venvs/memory-atlas/bin/python -B -m OpenAIDatabase.scripts.memory_atlas_private.api_server --host 127.0.0.1 --port 8766 --runtime-dir /srv/linze/state/memory-atlas --web-data-dir /srv/linze/apps/memory-atlas/shared/data --external-origin https://memoryatlas.linzezhang.com
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/linze/state/memory-atlas
UMask=0077

[Install]
WantedBy=multi-user.target
