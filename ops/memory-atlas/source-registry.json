{
  "schema_version": "memory_atlas.source_registry.v1",
  "policy": {
    "discovery": "explicit_roots_only",
    "raw_bytes": "lossless_no_redaction_no_encryption",
    "github_private_mirror": "lossless_age_encrypted_release_full_snapshot",
    "local_payload_retention": "zero_after_each_run",
    "standalone_credentials": "excluded_as_configuration_not_product_memory",
    "symlinks": "never_follow",
    "missing_required": "WAITING_SOURCE",
    "missing_optional": "visible_gap_not_success",
    "source_runner": "generic_one_shot; scheduler binding must be separately evidenced",
    "availability_tiers": "A_CLOUD_NATIVE 决定产品可用性；B_LOCAL_OPTIONAL 只影响采集完整性，缺失时降级不判失败"
  },
  "sources": [
    {
      "source_id": "codex_state",
      "label_zh": "Codex 状态数据库",
      "path_template": "$HOME/.codex/state_5.sqlite",
      "kind": "sqlite",
      "required": true,
      "recursive": false,
      "include_globs": [
        "*"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "codex_sessions",
      "label_zh": "Codex 活跃会话",
      "path_template": "$HOME/.codex/sessions",
      "kind": "files",
      "required": true,
      "recursive": true,
      "include_globs": [
        "**/*"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "codex_archived_sessions",
      "label_zh": "Codex 归档会话",
      "path_template": "$HOME/.codex/archived_sessions",
      "kind": "files",
      "required": false,
      "recursive": true,
      "include_globs": [
        "**/*"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "codex_memories",
      "label_zh": "Codex 记忆",
      "path_template": "$HOME/.codex/memories",
      "kind": "files",
      "required": false,
      "recursive": true,
      "include_globs": [
        "**/*"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "codex_attachments",
      "label_zh": "Codex 附件",
      "path_template": "$HOME/.codex/attachments",
      "kind": "files",
      "required": false,
      "recursive": true,
      "include_globs": [
        "**/*"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "codex_automations",
      "label_zh": "Codex Automation 配置与运行记忆",
      "path_template": "$HOME/.codex/automations",
      "kind": "files",
      "required": true,
      "recursive": true,
      "include_globs": [
        "**/*.toml",
        "**/*.md",
        "**/*.json",
        "**/*.jsonl"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "codex_tasks",
      "label_zh": "Codex 本机任务",
      "path_template": "$HOME/.codex/tasks",
      "kind": "files",
      "required": false,
      "recursive": true,
      "include_globs": [
        "**/*"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "chatgpt_exports",
      "label_zh": "ChatGPT 官方导出",
      "env_var": "MEMORY_ATLAS_CHATGPT_EXPORT_ROOTS",
      "path_template": "",
      "kind": "files",
      "required": false,
      "recursive": true,
      "include_globs": [
        "**/*"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "openaidatabase_live_data",
      "label_zh": "OpenAIDatabase 迁移期活数据",
      "env_var": "MEMORY_ATLAS_OPENAI_DATABASE_DATA_ROOTS",
      "path_template": "",
      "kind": "files",
      "required": false,
      "recursive": true,
      "include_globs": [
        "**/*"
      ],
      "exclude_globs": [
        "**/__pycache__/**",
        "**/*.pyc"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    },
    {
      "source_id": "verified_evidence_adapters",
      "label_zh": "可信结果证据适配器输出",
      "env_var": "MEMORY_ATLAS_VERIFIED_EVIDENCE_ROOTS",
      "path_template": "",
      "kind": "evidence_adapter",
      "required": false,
      "recursive": true,
      "include_globs": [
        "**/*.json",
        "**/*.jsonl",
        "**/*.ndjson"
      ],
      "exclude_globs": [
        "**/__pycache__/**",
        "**/*.pyc"
      ],
      "availability_tier": "B_LOCAL_OPTIONAL",
      "required_for_product": false
    }
  ],
  "cloud_native_authorities": [
    {
      "source_id": "r2_primary_objects",
      "label_zh": "R2 主对象字节",
      "availability_tier": "A_CLOUD_NATIVE",
      "required_for_capture": true,
      "required_for_product": true,
      "purpose_zh": "对象字节权威；读回校验失败即不得宣称当前数据可信。"
    },
    {
      "source_id": "r2_normalized_events",
      "label_zh": "R2 归一化事件流",
      "availability_tier": "A_CLOUD_NATIVE",
      "required_for_capture": true,
      "required_for_product": true,
      "purpose_zh": "本次运行的事件增量；缺失时页面没有可分析的事实。"
    },
    {
      "source_id": "private_database_facts",
      "label_zh": "Private-Database 结构化事实",
      "availability_tier": "A_CLOUD_NATIVE",
      "required_for_capture": true,
      "required_for_product": true,
      "purpose_zh": "长期结构化事实权威；缺失时运行身份无法核对。"
    },
    {
      "source_id": "github_private_release",
      "label_zh": "GitHub 私有仓全量备份",
      "availability_tier": "A_CLOUD_NATIVE",
      "required_for_capture": false,
      "required_for_product": false,
      "purpose_zh": "全量全时冷备；缺失是真实缺口，但今天的事实仍可呈现，只降级不判失败。"
    }
  ]
}
